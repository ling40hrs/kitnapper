# Line endings: the repository standard is LF everywhere.
# Normalize on commit and check out with LF so a Windows clone cannot
# rewrite files and produce whole-file diffs.
* text=auto eol=lf

# Windows launchers check out with CRLF so cmd.exe parses them reliably.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets: never normalize, never diff as text.
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ico binary
*.jar binary
